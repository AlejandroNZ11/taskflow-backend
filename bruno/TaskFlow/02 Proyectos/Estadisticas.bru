meta {
  name: Estadísticas del proyecto
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/projects/{{projectId}}/stats/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("trae estadísticas", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("progress_percent");
  });
}
