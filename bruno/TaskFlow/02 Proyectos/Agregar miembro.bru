meta {
  name: Agregar miembro
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/projects/{{projectId}}/members/add/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "username": "ana"
  }
}

tests {
  test("miembro agregado", function() {
    expect(res.status).to.equal(200);
    expect(res.body.members.map(m => m.username)).to.include("ana");
  });
}
