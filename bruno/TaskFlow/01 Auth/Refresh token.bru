meta {
  name: Refresh token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/refresh/
  body: json
  auth: none
}

body:json {
  {
    "refresh": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.access);
  }
}

tests {
  test("nuevo access token", function() {
    expect(res.status).to.equal(200);
  });
}
