get {
  url: {{baseUrl}}/api/auth/me/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("devuelve el usuario logueado", function() {
    expect(res.status).to.equal(200);
    expect(res.body.username).to.equal(bru.getEnvVar("username"));
  });
}
