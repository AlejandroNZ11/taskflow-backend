# Copiá este archivo como .env  (cp .env.example .env) y cambiá los valores.
# NUNCA subas el .env a GitHub.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=America/Argentina/Buenos_Aires
# Poné 1 solo si tenés HTTPS
DJANGO_SECURE_COOKIES=0

# --- PostgreSQL ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Superusuario automático (para entrar a /admin) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@taskflow.local
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena-admin

# --- Cargar datos de demo al iniciar (usuarios demo / ana) ---
SEED_DEMO=1
